# Copy to .env and edit before starting.

# LAN IP of the host running this bridge (the renderer fetches the stream from here)
HOST_IP=192.0.2.10

# LAN IP of your UPnP/DLNA renderer (WiiM, etc.). Leave empty to disable
# auto play/stop/volume control - you then start the stream URL manually.
RENDERER_IP=192.0.2.20

# Optional settings. Uncomment only the values that you want to change.

# AirPlay version: 1 = classic, 2 = AirPlay 2 (default).
# AIRPLAY_VERSION=2

# Receiver name. If omitted, use "AirPlay 1 Bridge" or "AirPlay 2 Bridge".
# AIRPLAY_NAME="Living Room"

# Host port for audio and the status page. Use 8001 for a second deployment.
# STREAM_PORT=8000

# Phone at full volume maps to this hardware volume on the renderer (0-100)
# MAX_VOLUME=100

# Push track title/artist/album/artwork to the renderer's display on track
# change. The renderer restarts the stream on each push (~2-4s gap per track).
# Set 0 for fully gapless audio with a static display instead.
# DIDL_PUSH=1

# Published bridge image: latest follows releases. Set a version to pin or roll back.
# BRIDGE_IMAGE_TAG=latest

# Connection limits and timeout tuning are documented in README.md.
