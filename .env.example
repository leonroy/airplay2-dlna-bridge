# Copy to .env and edit before starting.

# LAN IP of the host running this bridge (the renderer fetches the stream from here)
HOST_IP=192.168.1.10

# LAN IP of your UPnP/DLNA renderer (WiiM, etc.). Leave empty to disable
# auto play/stop/volume control - you then start the stream URL manually.
RENDERER_IP=192.168.1.20

# Port the audio stream is served on
STREAM_PORT=8000

# Published bridge image: latest follows new releases; pin e.g. 0.1.1 for rollback.
BRIDGE_IMAGE_TAG=latest

# Phone at full volume maps to this hardware volume on the renderer (0-100)
MAX_VOLUME=100

# Push track title/artist/album/artwork to the renderer's display on track
# change. The renderer restarts the stream on each push (~2-4s gap per track).
# Set 0 for fully gapless audio with a static display instead.
DIDL_PUSH=1

# Initial title/artwork quiet period in seconds (0.1-2.0; default 2.0).
# Experiment with 0.5 for faster initial playback once a title is available.
# Later metadata updates and title-less startup keep the 2 s debounce.
STARTUP_SETTLE=2.0

# EXPERIMENTAL: drop the stream on seek/pause so the renderer discards stale
# buffered audio. Known to stall WiiM playback after seeks - keep 0.
FLUSH_RESYNC=0
